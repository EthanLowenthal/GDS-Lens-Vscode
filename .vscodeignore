.vscode/**
.vscode-test/**
.vscode-test-web/**
test/**
.gitignore
**/jsconfig.json
**/*.map
**/eslint.config.mjs
**/.vscode-test.*
scripts/**
.env.publish*

# All of src/ is build input now, not runtime. esbuild bundles extension.cjs
# into dist/extension.js (what main/browser point at), and everything the
# webview loads is copied into dist/webview/ from the gds-lens package by
# scripts/copy-webview.mjs. Nothing under src/ is read at runtime any more.
src/**

# gds-lens is a production dependency, so vsce would otherwise pack the whole
# package (C++ sources, submodules, its own node_modules) into the .vsix. The
# only part the extension needs is dist/webview/, and that is already copied
# into our own dist/ at build time.
node_modules/**

# Internal docs. README.md, CHANGELOG.md, LICENCE.md and
# THIRD-PARTY-LICENSES.md still ship: vsce surfaces the first three on the
# listing, and the last is required by Qhull's licence, which grants no
# exemption for binary-only distribution of the wasm that links it.
DEVELOPING.md
