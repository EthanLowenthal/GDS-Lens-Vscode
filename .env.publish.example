# Copy to .env.publish (gitignored) and fill in. Never commit the real file.

# VS Code Marketplace. Azure DevOps personal access token:
#   https://dev.azure.com -> User settings -> Personal access tokens -> New
#   Organization: "All accessible organizations"  (required)
#   Scopes:       Custom defined -> Marketplace -> Manage
# Azure DevOps caps PAT lifetime at 1 year, so this expires and needs redoing.
#
# Only needed to publish to the Marketplace by hand. CI publishes from a tag
# without it; see "Marketplace sign-in" in DEVELOPING.md. Global PATs stop
# working on 2026-12-01.
VSCE_PAT=

# Open VSX. Token from https://open-vsx.org -> your profile -> Access Tokens
# (shown once at creation). Requires the Eclipse Publisher Agreement to be
# signed first, or publishing fails with a 403.
OVSX_PAT=
